UT\":\n        motor.motor_control2(motor.MotorChannel.G, motor.MotorShaftDirection.HIGH, 255)\n    elif receivedString == \"IN\":\n        motor.motor_control2(motor.MotorChannel.G, motor.MotorShaftDirection.LOW, 255)\n    elif receivedString == \"UP\":\n        motor.continuous_servo(motor.ServoChannel.P1, motor.SvconShaft.RIGHT)\n    elif receivedString == \"DOWN\":\n        motor.continuous_servo(motor.ServoChannel.P1, motor.SvconShaft.LEFT)\n    elif receivedString == \"STOP\":\n        STOP()\nradio.on_received_string(on_received_string)\n\nradio.set_group(69)\nradio.set_transmit_power(7)\nradio.set_frequency_band(69)\nbasic.show_icon(IconNames.HEART)","pxt.json":"{\n    \"name\": \"sho_camp\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"Pada Education \": \"github:Codepada/go#v0.0.2\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"targetVersions\": {\n        \"branch\": \"v6.0.27\",\n        \"tag\": \"v6.0.27\",\n        \"commits\": \"https://github.com/microsoft/pxt-microbit/commits/2c4654e7d5e6a85f8bbc1c2d48467b7665ccf95f\",\n        \"target\": \"6.0.27\",\n        \"pxt\": \"9.0.19\"\n    },\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1774323345658,"editorVersion":"8.0.18","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"radio_on_string_drag\" x=\"439\" y=\"-135\"><comment pinned=\"false\" h=\"80\" w=\"160\">เมื่อได้รับข้อความทาง radio</comment><value name=\"HANDLER_DRAG_PARAM_receivedString\"><block type=\"argument_reporter_string\" deletable=\"false\"><field name=\"VALUE\">receivedString</field></block></value><statement name=\"HANDLER\"><block type=\"controls_if\"><mutation elseif=\"10\"></mutation><value name=\"IF0\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</fi